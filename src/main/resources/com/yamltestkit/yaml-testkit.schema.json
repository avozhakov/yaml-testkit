{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamltestkit:yaml-testkit.schema.json",
  "title": "YAML Testkit",
  "description": "Case files (*.yaml), _context.yaml and _defaults.yaml of the YAML Testkit. The root dispatches on content for IDE use; the engine validates each file against its own definition (caseFile, contextFile, defaultsFile).",
  "if": {
    "anyOf": [
      {
        "required": [
          "cases"
        ]
      },
      {
        "required": [
          "name"
        ]
      },
      {
        "required": [
          "call"
        ]
      },
      {
        "required": [
          "steps"
        ]
      }
    ]
  },
  "then": {
    "$ref": "#/$defs/caseFile"
  },
  "else": {
    "if": {
      "anyOf": [
        {
          "required": [
            "application"
          ]
        },
        {
          "required": [
            "profiles"
          ]
        },
        {
          "required": [
            "properties"
          ]
        },
        {
          "required": [
            "mockBeans"
          ]
        },
        {
          "required": [
            "spyBeans"
          ]
        },
        {
          "required": [
            "valueBeans"
          ]
        },
        {
          "required": [
            "services"
          ]
        },
        {
          "required": [
            "variants"
          ]
        },
        {
          "required": [
            "converters"
          ]
        },
        {
          "required": [
            "settleMs"
          ]
        }
      ]
    },
    "then": {
      "$ref": "#/$defs/contextFile"
    },
    "else": {
      "$ref": "#/$defs/defaultsFile"
    }
  },
  "$defs": {
    "caseFile": {
      "description": "A single case, or an optional `defaults` block plus a `cases` list.",
      "if": {
        "type": "object",
        "required": [
          "cases"
        ]
      },
      "then": {
        "$ref": "#/$defs/caseList"
      },
      "else": {
        "$ref": "#/$defs/singleCase"
      }
    },
    "caseList": {
      "type": "object",
      "properties": {
        "defaults": {
          "$ref": "#/$defs/caseDefaults"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/listCase"
          }
        }
      },
      "required": [
        "cases"
      ],
      "additionalProperties": false
    },
    "caseDefaults": {
      "description": "Merged into each case of the file before the case's own values (case values win). `mocks`, `spies` and `http` form their own stub layer between _defaults.yaml and the case.",
      "$ref": "#/$defs/caseObject",
      "not": {
        "required": [
          "name"
        ]
      }
    },
    "listCase": {
      "description": "A case of a `cases` list. `call` may be partial here: it is completed by `defaults.call`.",
      "$ref": "#/$defs/caseObject",
      "required": [
        "name"
      ]
    },
    "singleCase": {
      "$ref": "#/$defs/caseObject",
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "required": [
            "call"
          ]
        },
        {
          "required": [
            "steps"
          ]
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "call": {
          "$ref": "#/$defs/call"
        },
        "mocks": {
          "$ref": "#/$defs/beanStubs"
        },
        "spies": {
          "$ref": "#/$defs/beanStubs"
        },
        "http": {
          "$ref": "#/$defs/httpStubs"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        }
      },
      "required": [
        "name",
        "call"
      ],
      "additionalProperties": false
    },
    "call": {
      "description": "Exactly one of `http`, `bean`, `class` names the call's kind and target; the other keys are that kind's fields (http: query, rawQuery, headers, body; bean: method, paramTypes, args; class: method, paramTypes, args, constructor, deps). A file's `defaults.call` and a case's `call` may each be partial: the kind and its fields are checked once they are merged.",
      "type": "object",
      "properties": {
        "http": {
          "description": "Request to the running application: \"<METHOD> <path>\", e.g. \"GET /ads\". The path has no spaces, `?` or `#`: the query goes in `query` or `rawQuery`.",
          "type": "string",
          "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) (/[^\\s?#]*)$"
        },
        "bean": {
          "description": "Method call on this bean of the application context.",
          "type": "string",
          "minLength": 1
        },
        "class": {
          "description": "Method call on an instance of this class, built by the engine without Spring.",
          "$ref": "#/$defs/typeName"
        },
        "query": {
          "description": "http: values are URL-encoded by the engine; a list repeats the parameter.",
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/scalar"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              }
            ]
          }
        },
        "rawQuery": {
          "description": "http: query string sent exactly as written, without re-encoding.",
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/scalarMap"
        },
        "body": {
          "$ref": "#/$defs/payload"
        },
        "method": {
          "description": "bean / class: the method to call.",
          "type": "string",
          "minLength": 1
        },
        "paramTypes": {
          "$ref": "#/$defs/typeNames"
        },
        "args": {
          "$ref": "#/$defs/payloadList"
        },
        "constructor": {
          "description": "class: parameter types of the constructor to use when the class has several.",
          "$ref": "#/$defs/typeNames"
        },
        "deps": {
          "description": "class: constructor parameters by parameter name, or by type (simple or fully qualified name) when exactly one parameter has it. Unlisted parameters are plain Mockito mocks.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/dep"
          }
        }
      },
      "not": {
        "required": [
          "query",
          "rawQuery"
        ]
      },
      "additionalProperties": false
    },
    "dep": {
      "type": "object",
      "properties": {
        "stubs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plainStub"
          }
        },
        "value": {
          "$ref": "#/$defs/payload"
        },
        "real": {
          "const": true
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "stubs"
          ]
        },
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "real"
          ]
        }
      ]
    },
    "beanStubs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beanStub"
      }
    },
    "beanStub": {
      "description": "A bare bean name (mock / spy without stubbing) or a stub naming its bean.",
      "anyOf": [
        {
          "$ref": "#/$defs/beanName"
        },
        {
          "$ref": "#/$defs/stub",
          "required": [
            "bean"
          ]
        }
      ]
    },
    "stub": {
      "type": "object",
      "properties": {
        "bean": {
          "$ref": "#/$defs/beanName"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "paramTypes": {
          "$ref": "#/$defs/typeNames"
        },
        "args": {
          "description": "Per argument: a literal (JSON equality after conversion), \"#any\", or { anyOf: <FQN> }. Absent: any arguments.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/argMatcher"
          }
        },
        "returns": {
          "$ref": "#/$defs/payload"
        },
        "returnsArg": {
          "type": "integer",
          "minimum": 0
        },
        "throws": {
          "$ref": "#/$defs/throwSpec"
        },
        "answers": {
          "description": "Answers for consecutive calls; the last one repeats.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "returns": {
                "$ref": "#/$defs/payload"
              },
              "throws": {
                "$ref": "#/$defs/throwSpec"
              }
            },
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "returns"
                ]
              },
              {
                "required": [
                  "throws"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "method"
      ],
      "oneOf": [
        {
          "required": [
            "returns"
          ]
        },
        {
          "required": [
            "returnsArg"
          ]
        },
        {
          "required": [
            "throws"
          ]
        },
        {
          "required": [
            "answers"
          ]
        }
      ],
      "additionalProperties": false
    },
    "argMatcher": {
      "description": "A literal, \"#any\", or { anyOf: <FQN> }.",
      "if": {
        "type": "object",
        "required": [
          "anyOf"
        ]
      },
      "then": {
        "properties": {
          "anyOf": {
            "$ref": "#/$defs/typeName"
          }
        },
        "additionalProperties": false
      },
      "else": {
        "$ref": "#/$defs/payload"
      }
    },
    "throwSpec": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "message": {
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/payloadList"
        },
        "cause": {
          "$ref": "#/$defs/throwSpec"
        }
      },
      "required": [
        "type"
      ],
      "not": {
        "required": [
          "message",
          "args"
        ]
      },
      "additionalProperties": false
    },
    "httpStubs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/httpStub"
      }
    },
    "httpStub": {
      "description": "WireMock stub of a service declared in _context.yaml. Request matching keys sit at the top level (as in `verify`), the answer in `response` or `responses` + `sequence: true`.",
      "type": "object",
      "properties": {
        "service": {
          "$ref": "#/$defs/serviceName"
        },
        "method": {
          "$ref": "#/$defs/httpMethodOrAny"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "pathPattern": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "$ref": "#/$defs/scalarMap"
        },
        "headers": {
          "$ref": "#/$defs/scalarMap"
        },
        "body": {
          "description": "Expected JSON request body (WireMock equalToJson).",
          "$ref": "#/$defs/payload"
        },
        "response": {
          "$ref": "#/$defs/httpResponse"
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/httpResponse"
          }
        },
        "sequence": {
          "const": true
        }
      },
      "required": [
        "service"
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "response"
              ]
            },
            {
              "required": [
                "responses",
                "sequence"
              ]
            }
          ]
        },
        {
          "not": {
            "required": [
              "path",
              "pathPattern"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "httpResponse": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/httpStatus"
        },
        "headers": {
          "$ref": "#/$defs/scalarMap"
        },
        "body": {
          "$ref": "#/$defs/payload"
        },
        "delayMs": {
          "type": "integer",
          "minimum": 0
        },
        "fault": {
          "enum": [
            "CONNECTION_RESET_BY_PEER",
            "EMPTY_RESPONSE",
            "MALFORMED_RESPONSE_CHUNK",
            "RANDOM_DATA_THEN_CLOSE"
          ]
        },
        "template": {
          "description": "Render the response with WireMock response templating.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "expect": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/httpStatus"
        },
        "headers": {
          "$ref": "#/$defs/scalarMap"
        },
        "body": {
          "$ref": "#/$defs/bodyExpectation"
        },
        "bodyText": {
          "$ref": "#/$defs/textMatchers"
        },
        "assert": {
          "$ref": "#/$defs/assertions"
        },
        "returns": {
          "$ref": "#/$defs/payload"
        },
        "throws": {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "#/$defs/typeName"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "verify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verifyCheck"
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/logExpectation"
          }
        },
        "context": {
          "$ref": "#/$defs/contextExpectation"
        },
        "within": {
          "$ref": "#/$defs/duration"
        },
        "every": {
          "$ref": "#/$defs/duration"
        }
      },
      "not": {
        "required": [
          "returns",
          "throws"
        ]
      },
      "dependentRequired": {
        "every": [
          "within"
        ]
      },
      "additionalProperties": false
    },
    "bodyExpectation": {
      "description": "Expected JSON body, inline or { file }. With options: { file | value, mode?, ignore? }. Default compare: extra actual fields allowed, array order significant; `strict` forbids extra fields; `exact` compares raw text.",
      "if": {
        "type": "object",
        "required": [
          "file"
        ]
      },
      "then": {
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "$ref": "#/$defs/bodyMode"
          },
          "ignore": {
            "$ref": "#/$defs/jsonPaths"
          }
        },
        "additionalProperties": false
      },
      "else": {
        "if": {
          "type": "object",
          "required": [
            "value"
          ],
          "anyOf": [
            {
              "required": [
                "mode"
              ]
            },
            {
              "required": [
                "ignore"
              ]
            }
          ]
        },
        "then": {
          "properties": {
            "value": true,
            "mode": {
              "$ref": "#/$defs/bodyMode"
            },
            "ignore": {
              "$ref": "#/$defs/jsonPaths"
            }
          },
          "additionalProperties": false,
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "exact"
              }
            }
          },
          "then": {
            "description": "`exact` compares raw text, so the expected value is a string.",
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "bodyMode": {
      "enum": [
        "lenient",
        "strict",
        "exact"
      ]
    },
    "textMatchers": {
      "type": "object",
      "properties": {
        "equals": {
          "$ref": "#/$defs/textValues"
        },
        "contains": {
          "$ref": "#/$defs/textValues"
        },
        "notContains": {
          "$ref": "#/$defs/textValues"
        },
        "startsWith": {
          "$ref": "#/$defs/textValues"
        },
        "matches": {
          "$ref": "#/$defs/textValues"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "textValues": {
      "anyOf": [
        {
          "$ref": "#/$defs/textValue"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/textValue"
          }
        }
      ]
    },
    "textValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/fileRef"
        }
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "assertion": {
      "description": "JSONPath assertion. `isNull`: key missing or null; `exists`: key present; `absent`: key missing; `notNull`: present and not null.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[$@]"
        },
        "parseJson": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "lenient",
            "strict"
          ]
        },
        "equals": {
          "$ref": "#/$defs/expectedValue"
        },
        "notEquals": {
          "$ref": "#/$defs/expectedValue"
        },
        "isNull": {
          "const": true
        },
        "notNull": {
          "const": true
        },
        "exists": {
          "const": true
        },
        "absent": {
          "const": true
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "gte": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "contains": {
          "$ref": "#/$defs/expectedValue"
        },
        "containsExactly": {
          "type": "array"
        },
        "containsInAnyOrder": {
          "type": "array"
        },
        "unique": {
          "const": true
        },
        "startsWith": {
          "type": "string"
        },
        "matches": {
          "type": "string"
        },
        "all": {
          "$ref": "#/$defs/assertion"
        },
        "none": {
          "$ref": "#/$defs/assertion"
        }
      },
      "required": [
        "path"
      ],
      "not": {
        "description": "At least one operator besides path / parseJson / mode.",
        "propertyNames": {
          "enum": [
            "path",
            "parseJson",
            "mode"
          ]
        }
      },
      "additionalProperties": false
    },
    "expectedValue": {
      "description": "A literal, { file }, or a reference { ref, path?, parseJson? } to an earlier step's result or a `verify[].as` capture.",
      "if": {
        "type": "object",
        "required": [
          "ref"
        ]
      },
      "then": {
        "$ref": "#/$defs/valueRef"
      },
      "else": {
        "$ref": "#/$defs/payload"
      }
    },
    "valueRef": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^\\$"
        },
        "parseJson": {
          "type": "boolean"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "verifyCheck": {
      "description": "Check on a mock or spy (`bean` for http / bean cases, `dep` for class cases) or on the request journal of a WireMock `service`.",
      "type": "object",
      "properties": {
        "bean": {
          "$ref": "#/$defs/beanName"
        },
        "dep": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "$ref": "#/$defs/serviceName"
        },
        "method": {
          "description": "Bean / dep method name, or HTTP method for a `service` check.",
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "pathPattern": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "$ref": "#/$defs/scalarMap"
        },
        "headers": {
          "$ref": "#/$defs/scalarMap"
        },
        "body": {
          "description": "Expected JSON request body (WireMock equalToJson).",
          "$ref": "#/$defs/payload"
        },
        "paramTypes": {
          "$ref": "#/$defs/typeNames"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/argMatcher"
          }
        },
        "argType": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "$ref": "#/$defs/typeName"
            }
          },
          "required": [
            "index",
            "type"
          ],
          "additionalProperties": false
        },
        "noInteractions": {
          "const": true
        },
        "times": {
          "type": "integer",
          "minimum": 0
        },
        "atLeast": {
          "type": "integer",
          "minimum": 1
        },
        "never": {
          "const": true
        },
        "within": {
          "$ref": "#/$defs/duration"
        },
        "as": {
          "type": "string",
          "minLength": 1
        },
        "assert": {
          "$ref": "#/$defs/assertions"
        }
      },
      "oneOf": [
        {
          "required": [
            "bean"
          ]
        },
        {
          "required": [
            "dep"
          ]
        },
        {
          "required": [
            "service"
          ]
        }
      ],
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "times",
                  "atLeast"
                ]
              },
              {
                "required": [
                  "times",
                  "never"
                ]
              },
              {
                "required": [
                  "atLeast",
                  "never"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "service"
            ]
          },
          "then": {
            "properties": {
              "method": {
                "$ref": "#/$defs/httpMethodOrAny"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "paramTypes"
                  ]
                },
                {
                  "required": [
                    "args"
                  ]
                },
                {
                  "required": [
                    "argType"
                  ]
                },
                {
                  "required": [
                    "noInteractions"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "pathPattern"
                  ]
                },
                {
                  "required": [
                    "query"
                  ]
                },
                {
                  "required": [
                    "headers"
                  ]
                },
                {
                  "required": [
                    "body"
                  ]
                }
              ]
            }
          }
        },
        {
          "not": {
            "required": [
              "path",
              "pathPattern"
            ]
          }
        },
        {
          "if": {
            "required": [
              "noInteractions"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "method"
                  ]
                },
                {
                  "required": [
                    "args"
                  ]
                },
                {
                  "required": [
                    "argType"
                  ]
                },
                {
                  "required": [
                    "times"
                  ]
                },
                {
                  "required": [
                    "atLeast"
                  ]
                },
                {
                  "required": [
                    "never"
                  ]
                },
                {
                  "required": [
                    "as"
                  ]
                },
                {
                  "required": [
                    "assert"
                  ]
                }
              ]
            }
          },
          "else": {
            "if": {
              "not": {
                "required": [
                  "service"
                ]
              }
            },
            "then": {
              "required": [
                "method"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "logExpectation": {
      "type": "object",
      "properties": {
        "logger": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "TRACE",
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR"
          ]
        },
        "contains": {
          "type": "string"
        },
        "times": {
          "type": "integer",
          "minimum": 0
        },
        "absent": {
          "const": true
        }
      },
      "required": [
        "logger",
        "level"
      ],
      "not": {
        "required": [
          "times",
          "absent"
        ]
      },
      "additionalProperties": false
    },
    "contextExpectation": {
      "type": "object",
      "properties": {
        "beans": {
          "$ref": "#/$defs/presence"
        },
        "beanTypes": {
          "$ref": "#/$defs/presence"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "presence": {
      "type": "object",
      "properties": {
        "present": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "absent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "contextFile": {
      "description": "_context.yaml: how the engine starts the application for http / bean cases.",
      "type": "object",
      "properties": {
        "application": {
          "description": "Fully qualified name of the Spring Boot application class.",
          "$ref": "#/$defs/typeName"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties": {
          "$ref": "#/$defs/properties"
        },
        "mockBeans": {
          "$ref": "#/$defs/mockBeans"
        },
        "spyBeans": {
          "$ref": "#/$defs/spyBeans"
        },
        "valueBeans": {
          "$ref": "#/$defs/valueBeans"
        },
        "services": {
          "description": "WireMock services; each exposes ${wiremock.<service>.url|host|port}.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/serviceName"
          }
        },
        "variants": {
          "description": "Named variants; a variant adds or overrides properties and bean entries.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "properties": {
                "$ref": "#/$defs/properties"
              },
              "mockBeans": {
                "$ref": "#/$defs/mockBeans"
              },
              "spyBeans": {
                "$ref": "#/$defs/spyBeans"
              },
              "valueBeans": {
                "$ref": "#/$defs/valueBeans"
              }
            },
            "additionalProperties": false
          }
        },
        "converters": {
          "$ref": "#/$defs/typeNames"
        },
        "settleMs": {
          "description": "Wait before each http / bean case of the root except the first, and after a shared context starts.",
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "defaultsFile": {
      "description": "_defaults.yaml: stubs applied before each http / bean case.",
      "type": "object",
      "properties": {
        "mocks": {
          "$ref": "#/$defs/beanStubs"
        },
        "spies": {
          "$ref": "#/$defs/beanStubs"
        },
        "http": {
          "$ref": "#/$defs/httpStubs"
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "description": "Spring properties; they take precedence over the application's own configuration files.",
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/scalar"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/scalar"
            }
          }
        ]
      }
    },
    "payload": {
      "description": "Inline value (YAML null is Java null) or { file: <path> } relative to the case file.",
      "if": {
        "type": "object",
        "required": [
          "file"
        ]
      },
      "then": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "payloadList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/payload"
      }
    },
    "fileRef": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "scalarMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "httpMethodOrAny": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS",
        "ANY"
      ]
    },
    "httpStatus": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "beanName": {
      "type": "string",
      "minLength": 1
    },
    "serviceName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "typeName": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*(\\[\\])*$"
    },
    "typeNames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typeName"
      }
    },
    "jsonPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\$"
      }
    },
    "duration": {
      "description": "Duration such as 200ms, 3s or 1m.",
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m)$"
    },
    "caseObject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "call": {
          "$ref": "#/$defs/call"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "mocks": {
          "$ref": "#/$defs/beanStubs"
        },
        "spies": {
          "$ref": "#/$defs/beanStubs"
        },
        "http": {
          "$ref": "#/$defs/httpStubs"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "context": {
          "description": "Name of a variant declared under `variants` in _context.yaml; null selects the default variant (e.g. to override `defaults.context`).",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "freshContext": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "plainStub": {
      "description": "A stub without `bean` (boot-time `stubs`, `deps.<name>.stubs`).",
      "$ref": "#/$defs/stub",
      "not": {
        "required": [
          "bean"
        ]
      }
    },
    "mockBeans": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/beanName"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/$defs/beanName"
              },
              "type": {
                "description": "Creates the bean when no definition with this name exists.",
                "$ref": "#/$defs/typeName"
              },
              "primary": {
                "type": "boolean"
              },
              "stubs": {
                "description": "Active from mock creation (context startup) and the lowest stub layer of every case of the variant.",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/plainStub"
                }
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "spyBeans": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/beanName"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/$defs/beanName"
              },
              "stubs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/plainStub"
                }
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "valueBeans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/beanName"
          },
          "type": {
            "$ref": "#/$defs/typeName"
          },
          "value": {
            "$ref": "#/$defs/payload"
          },
          "primary": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    }
  }
}
